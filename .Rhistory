# n (np) x np (np)
# alpha_hat <- D_hat %*% solve(C_hat)
alpha_hat <- D_hat %*% C_dag / nrow(D_hat)
# alpha_hat <- adjacent(D_hat, C_dag)
plot_fd(alpha_hat)
# plot_fd(dat_500_1$params$alpha)
# plot_fd(alpha_hat)
## Delta, Eq 39
mxp <- .mean_vech(X = X2p,p = p,lag = 0,lag2 = 0)
alpha_applied <- operator(alpha_hat, mxp)
delta_hat <-
apply(adjacent(matrix(C_X,n,n) - adjacent(matrix(alpha_applied,n,n), C_eps), C_eps_dag), 2, pmax, 0)
list('hat_alpha'=alpha_hat,
'hat_delta'=delta_hat,
'C_hat'=C_hat,
'D_hat'=D_hat)
}
.CD_hat_vech <- function(X2, X2p, p, C_eps_dag){
N <- dim(X2p)[3]
np <- nrow(X2p)
n <- nrow(X2)
# Eqs 20 and 21
#   C: (pnn x pnn)
#   D: (nn x pnn)
Chat <-  matrix(0, nrow=np*(np+1)/2, ncol=np*(np+1)/2)
Dhat <-  matrix(0, nrow=n*(n+1)/2, ncol=np*(np+1)/2)
# After Eq 35
mx2p <- .mean_vech(X2p,p=p,lag=0,lag2=0)
mx2p_pr <- .mean_vech(X2p,p=p,lag=1,lag2=0)
mx2_pr <- .mean_vech(X2,p=p,lag=1,lag2=1)
Chat <- tensor_vech(X2[,,N]-mx2p, X2p[,,N]-mx2p)
for(k in p:(N-1)){
## C_hat, Eq 20
#   N case computed before loop
Chat <- Chat + tensor_vech(X2[,,k]-mx2p, X2p[,,k]-mx2p)
## D_hat, Eq 21
Dhat <- Dhat + tensor_vech(X2p[,,k]-mx2p_pr,
adjacent(X2[,,k+1]-mx2_pr,C_eps_dag))
}
list('C_hat'= Chat / (N-p),
'D_hat'= Dhat / (N-p-1)
)
}
.mean_vech <- function(X, p, lag,lag2=0){
mat <- matrix(0, nrow=nrow(X), ncol=nrow(X))
N <- ncol(X)
for(k in p:(N-lag)){
mat <- mat + X[,,k+lag2]
}
mat / (N-p+1-lag)
}
# Eqs 35 and 36
tmp <- .CD_hat_vech(X2 = X2, X2p=X2p, p = p, C_eps_dag=C_eps_dag)
C_hat <- tmp$C_hat
D_hat <- tmp$D_hat
# # After Eq 36 and Eq 39
eig_C <- eigen( C_hat )
CC_n <- nrow(eig_C$vectors)
# Make Correct
eig_C$vectors <- eig_C$vectors * sqrt(CC_n)
eig_C$values <- eig_C$values / CC_n # ADDED
K_C <- which.min(cumsum(eig_C$values)/sum(eig_C$values) < 1-w)
# Estimate alpha
C_dag <- matrix(0, nrow=nrow(C_hat), ncol=ncol(C_hat))
for(i in 1:K_C){
C_dag <- C_dag +
( 1 / eig_C$values[i] ) * (eig_C$vectors[,i] %o% eig_C$vectors[,i] )
# ( 1 / eig_C$values[i] ) * (eig_C$vectors[,i] %*% t(eig_C$vectors[,i] ))
}
# n (np) x np (np)
# alpha_hat <- D_hat %*% solve(C_hat)
alpha_hat <- D_hat %*% C_dag / nrow(D_hat)
# alpha_hat <- adjacent(D_hat, C_dag)
plot_fd(alpha_hat)
plot_fd(dat_500_1$params$alpha)
